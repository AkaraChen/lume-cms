{
  "name": "lume-cms",
  "version": "0.1.0",
  "description": "Runtime-aware content source for Fumadocs",
  "type": "module",
  "license": "MIT",
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "lume-cms": "./bin/lume-cms.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./schedule": {
      "types": "./dist/schedule.d.mts",
      "import": "./dist/schedule.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "size": "size-limit",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:package"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@standard-schema/spec": "^1.1.0",
    "c12": "^3.3.3",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.0.0",
    "react": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fumadocs-core": "^16.14.0",
    "knip": "^6.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^11.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "valibot": "^1.1.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1"
}
