{
  "name": "lume-cms",
  "version": "0.1.0",
  "description": "Runtime-aware content source for Fumadocs",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bin": {
    "lume-cms": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./compile": {
      "types": "./dist/compile.d.mts",
      "import": "./dist/compile.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./fumadocs": {
      "types": "./dist/fumadocs.d.mts",
      "import": "./dist/fumadocs.mjs"
    },
    "./unsafe": {
      "types": "./dist/unsafe.d.mts",
      "import": "./dist/unsafe.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:package"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@standard-schema/spec": "^1.1.0",
    "c12": "^3.3.3",
    "date-fns-tz": "^3.2.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "valibot": "^1.1.0",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fumadocs-core": "^16.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1"
}
